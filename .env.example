# Copy to .env and adjust. No real secrets belong in this file or in git.

# --- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-50
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (required: this project does not run on SQLite) ---------
POSTGRES_DB=wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_TEST_DB=test_wallet
POSTGRES_CONN_MAX_AGE=0
POSTGRES_CONNECT_TIMEOUT=10
